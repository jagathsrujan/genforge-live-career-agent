# OpenCode Zen key used by Pi for live runs. Never commit a real key.
OPENCODE_API_KEY=

# Pi model id. The default supports text and image inputs.
GENFORGE_PI_MODEL=opencode/deepseek-v4-flash-free
GENFORGE_PI_THINKING=max
GENFORGE_PI_IMAGE_MODEL=opencode/mimo-v2.5-free
GENFORGE_PI_IMAGE_THINKING=max

# Optional local storage location. Defaults to ~/Library/Application Support/GenForge on macOS.
GENFORGE_DATA_DIR=

# Optional runtime overrides for local testing. Keep these out of workspace data.
GENFORGE_HOST=127.0.0.1
GENFORGE_PI_BIN=pi
GENFORGE_PI_EXTENSION=

# Local server port used by `resume agent`.
GENFORGE_PORT=3000
